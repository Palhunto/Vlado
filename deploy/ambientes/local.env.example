# Ambiente: LOCAL, no computador do dono (D7). Copie para deploy/ambientes/local.env (fora do git) e preencha só o
# que está marcado PREENCHER. O script deploy/vlado-local.ps1 faz a cópia na primeira vez. Dados sintéticos apenas.
# Projeto Compose próprio (vlado-local), portas e nomes que não colidem com os vlado-homologacao-*.
# homologacao ou demonstracao (dados sintéticos); o script recusa qualquer outro, em especial o editorial.
VLADO_AMBIENTE=homologacao
# Nome com .localhost: o navegador o leva ao próprio computador sem mexer no arquivo hosts, e os cookies ficam
# separados dos do `localhost` da homologação que já roda aqui (cookie não separa por porta).
VLADO_DOMINIO=vlado.localhost
# Etiqueta própria da imagem: precisa começar com "local-" (o script recusa vazia, "local" e qualquer outra), para nunca
# regravar vlado:local nem as imagens da homologação.
VLADO_VERSAO=local-dono
# CA interna do Caddy (certificado local). O navegador precisa confiar nela: ver deploy/LOCAL.md.
VLADO_CADDYFILE=deploy/Caddyfile.interno
# Porta HTTPS neste computador (de 1024 a 65535). O endereço é sempre 127.0.0.1, escrito em deploy/compose.local.yml:
# só esta máquina alcança. A 9443 não colide com a homologação (443 e 8080). Não existe porta HTTP: sempre https://.
# Não use VLADO_PORTA_HTTPS nem VLADO_PORTA_HTTP aqui (o script recusa).
VLADO_LOCAL_PORTA=9443
# Precisa ser exatamente https://<VLADO_DOMINIO>:<VLADO_LOCAL_PORTA> (o script confere).
VLADO_ORIGEM=https://vlado.localhost:9443

# Limites de memória para caber em 8 GB junto com os agentes. São TETOS, não reservas: o que o contêiner não
# usa fica livre. App 2 GB (o padrão de servidor é 5 GB), Caddy 256 MB (fixo no compose), backup 512 MB.
# Soma máxima ~2,8 GB. PDF escaneado grande no OCR pode estourar 2g (o app é morto e reinicia): com os agentes
# parados, suba para 3g.
VLADO_MEM_LIMITE=2g
VLADO_BACKUP_MEM_LIMITE=512m
VLADO_TMP_TAMANHO=64m
# Extração (CONF-02, SEG-01): cada processo de extração tem um teto de memória. Os padrões de servidor (2 processos de 2048 MB)
# não cabem no teto de 2g do app: aqui, 1 processo de 1024 MB (a Mesa fica com o resto). Um PDF que precise de mais que isso
# falha com o motivo na fila (o original é cadastrado mesmo assim); com os agentes parados, suba VLADO_MEM_LIMITE=3g e o teto
# para 2048. Os demais (PAGINAS, TEMPO_MAXIMO, TETO_PAGINAS, TETO_MEGAPIXELS, TETO_CPU_S, NUCLEOS) seguem o padrão.
VLADO_EXTRACAO_PROCESSOS=1
VLADO_EXTRACAO_TETO_MEMORIA_MB=1024

# Backup agendado para uma PASTA do computador (destino de teste). Fica na mesma máquina: não vale como backup
# de verdade. Use barras normais (C:/Users/...) e uma pasta FORA do repositório.
# PREENCHER: pasta (criada se não existir).
VLADO_LOCAL_BACKUP_PASTA=C:/Users/SEU-USUARIO/Vlado-backups-teste
VLADO_BACKUP_DESTINO=/destino-backup
# PREENCHER: chave PÚBLICA age (age1...) do dono. A chave PRIVADA nunca vai neste arquivo. Como gerar: deploy/BACKUP.md.
VLADO_BACKUP_DESTINATARIOS=
# Notebook: o computador pode estar desligado no horário. Por isso uma rodada ao subir e um horário em hora
# comercial (15:00 UTC = 12:00 em Brasília). Com 72 h o aviso de "backup atrasado" não dispara no fim de semana.
VLADO_BACKUP_AO_INICIAR=1
VLADO_BACKUP_HORARIO_UTC=15:00
VLADO_BACKUP_IDADE_MAX_H=72
VLADO_BACKUP_RETENCAO=diarios=7,semanais=4,mensais=3

# Vigia (alerta de que a Mesa caiu): DESLIGADA de propósito. Ela avisa um endereço de fora; sem ele não roda, e
# um aviso de "caiu" não existiria de qualquer modo com o computador desligado. Para saber se está de pé, use
# `deploy\vlado-local.ps1 status` (o serviço backup aparece "unhealthy" se o backup falhar ou atrasar).
# VLADO_VIGIA_PING_URL=
# Opcional: chave da API no ambiente (tem prioridade sobre a colada na Mesa). Nunca commitar.
# ANTHROPIC_API_KEY=

# Registro de auditoria (autenticação, administração, downloads): fica no volume `registro` deste ambiente, 30 dias por padrão.
# Ler: deploy\vlado-local.ps1 auditoria (as últimas 200 linhas).
# VLADO_REGISTRO_RETENCAO_DIAS=30
