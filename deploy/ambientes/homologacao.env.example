# Ambiente: homologacao — copie para deploy/ambientes/homologacao.env (fora do git) e preencha.
# Dados sintéticos apenas. Para homologar na própria máquina, use localhost e as opções comentadas abaixo.
VLADO_AMBIENTE=homologacao
# PREENCHER: domínio público deste ambiente (DNS apontando para o servidor).
VLADO_DOMINIO=homologacao.vlado.example.org
# Tag da imagem; mantenha a anterior para reverter.
VLADO_VERSAO=2.2.0
# Portas publicadas pelo Caddy (padrão 80/443).
# VLADO_PORTA_HTTP=80
# VLADO_PORTA_HTTPS=443
# VLADO_CADDYFILE=deploy/Caddyfile
# Alternativa local: VLADO_DOMINIO=localhost
# VLADO_CADDYFILE=deploy/Caddyfile.interno
# VLADO_PORTA_HTTP=127.0.0.1:8080
# VLADO_PORTA_HTTPS=127.0.0.1:8443
# VLADO_ORIGEM=https://localhost:8443
# Opcional: chave da API no ambiente (tem prioridade sobre a colada na Mesa). Nunca commitar.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Limites do contêiner do app (SEG-04). Padrões pensados para 4 vCPU e 8 GB
# VLADO_MEM_LIMITE=5g
# Teto de CPU opcional (precisa de N <= núcleos do servidor): ver deploy/compose.limite-cpu.yml.
# VLADO_CPUS=3
# /tmp em memória (pequeno). Os temporários do OCR vão para o volume tmp_vlado, em disco: deixe espaço livre.
# VLADO_TMP_TAMANHO=64m

# Backup agendado, cifrado e fora do servidor (SEG-03). Passo a passo para o dono: deploy/BACKUP.md.
# O serviço `backup` sobe junto e fica "unhealthy" até DESTINO e DESTINATARIOS estarem preenchidos.
# PREENCHER: destino fora do servidor, no formato do rclone (`remoto:bucket/prefixo`); as credenciais do remoto
# vão em deploy/ambientes/<ambiente>-backup.env (RCLONE_CONFIG_<REMOTO>_*), nunca neste arquivo nem no git.
# VLADO_BACKUP_DESTINO=
# PREENCHER: chave PÚBLICA age (age1...) do dono. A chave PRIVADA nunca vem para o servidor.
# VLADO_BACKUP_DESTINATARIOS=
# Horário diário em UTC (06:30 UTC = 03:30 em Brasília) e retenção (diários, semanais e mensais a guardar).
# VLADO_BACKUP_HORARIO_UTC=06:30
# VLADO_BACKUP_RETENCAO=diarios=7,semanais=4,mensais=6
# Opcional: endereço de aviso de monitoramento (recebe GET a cada sucesso e /fail a cada falha).
# VLADO_BACKUP_PING_URL=

# Monitoramento (Fase 3): passo a passo em deploy/MONITORAMENTO.md.
# PREENCHER: endereço de batimento do healthchecks.io (um check por ambiente, período de 1 min, tolerância de 5 min).
# A cada minuto o serviço de backup confere /saude e o disco livre e avisa esse endereço; se a Mesa cair ou o
# disco passar do limite vai `<endereço>/fail` na hora, e se o servidor parar os avisos deixam de chegar.
# VLADO_VIGIA_PING_URL=
# VLADO_VIGIA_DISCO_MIN_GB=5
