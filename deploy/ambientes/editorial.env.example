# Ambiente: editorial — copie para deploy/ambientes/editorial.env (fora do git) e preencha.
# Piloto editorial privado da redação. Só sobe depois da homologação. O APK 'redacao' aponta para este domínio.
VLADO_AMBIENTE=editorial
# PREENCHER: domínio público deste ambiente (DNS apontando para o servidor).
VLADO_DOMINIO=vlado.redacao.example.org
# Tag da imagem; mantenha a anterior para reverter.
VLADO_VERSAO=2.2.0
# Portas publicadas pelo Caddy (padrão 80/443).
# VLADO_PORTA_HTTP=80
# VLADO_PORTA_HTTPS=443
# VLADO_CADDYFILE=deploy/Caddyfile
# Opcional: chave da API no ambiente (tem prioridade sobre a colada na Mesa). Nunca commitar.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Limites do contêiner do app (SEG-04). Padrões pensados para 4 vCPU e 8 GB
# VLADO_MEM_LIMITE=5g
# Teto de CPU opcional (precisa de N <= núcleos do servidor): ver deploy/compose.limite-cpu.yml.
# VLADO_CPUS=3
# /tmp em memória (pequeno). Os temporários do OCR vão para o volume tmp_vlado, em disco: deixe espaço livre.
# VLADO_TMP_TAMANHO=64m

# Backup agendado, cifrado e fora do servidor (SEG-03). Passo a passo para o dono: deploy/BACKUP.md.
# O serviço `backup` sobe junto e fica "unhealthy" até DESTINO e DESTINATARIOS estarem preenchidos.
# PREENCHER: destino fora do servidor, no formato do rclone (`remoto:bucket/prefixo`); as credenciais do remoto
# vão em deploy/ambientes/<ambiente>-backup.env (RCLONE_CONFIG_<REMOTO>_*), nunca neste arquivo nem no git.
# VLADO_BACKUP_DESTINO=
# PREENCHER: chave PÚBLICA age (age1...) do dono. A chave PRIVADA nunca vem para o servidor.
# VLADO_BACKUP_DESTINATARIOS=
# Horário diário em UTC (06:30 UTC = 03:30 em Brasília) e retenção (diários, semanais e mensais a guardar).
# VLADO_BACKUP_HORARIO_UTC=06:30
# VLADO_BACKUP_RETENCAO=diarios=7,semanais=4,mensais=6
# Opcional: endereço de aviso de monitoramento (recebe GET a cada sucesso e /fail a cada falha).
# VLADO_BACKUP_PING_URL=

# Monitoramento (Fase 3): passo a passo em deploy/MONITORAMENTO.md.
# PREENCHER: endereço de batimento do healthchecks.io (um check por ambiente, período de 1 min, tolerância de 5 min).
# A cada minuto o serviço de backup confere /saude e o disco livre e avisa esse endereço; se a Mesa cair ou o
# disco passar do limite vai `<endereço>/fail` na hora, e se o servidor parar os avisos deixam de chegar.
# VLADO_VIGIA_PING_URL=
# VLADO_VIGIA_DISCO_MIN_GB=5

# Registro de auditoria da Mesa (SEG-02): autenticação, administração e downloads, sem conteúdo, no volume `registro` (fora do
# backup). Retenção em dias (padrão 30, o mesmo do Caddy) e teto de tamanho por dia em MB. IP é dado pessoal: ver deploy/MONITORAMENTO.md.
# VLADO_REGISTRO_RETENCAO_DIAS=30
# VLADO_REGISTRO_DIA_MAX_MB=50
# Atrás de CDN ou WAF (SEG-05): IPs ou redes dos proxies de confiança (a rede do Compose e as faixas da CDN), separados por vírgula.
# Vazio: comportamento de sempre (último salto do X-Forwarded-For). Passo a passo e o trusted_proxies do Caddy: deploy/MONITORAMENTO.md.
# VLADO_PROXIES_CONFIAVEIS=
# Uma rede que cobre quase toda a internet (0.0.0.0/0, ::/0) é recusada e a Mesa não sobe; só a confirmação explícita a aceita:
# VLADO_PROXIES_CONFIAVEIS_AMPLAS=1

# Extração e OCR (CONF-02) e tetos do documento recebido (SEG-01). Cada processo de extração tem um teto de memória (RLIMIT_AS):
# PROCESSOS x TETO_MEMORIA_MB, mais a Mesa, tem de caber em VLADO_MEM_LIMITE. Padrões (descomente para mudar):
# VLADO_EXTRACAO_PROCESSOS=2        # arquivos extraídos ao mesmo tempo
# VLADO_EXTRACAO_PAGINAS=4          # páginas de OCR ao mesmo tempo, somadas (padrão: o menor entre 4 e o número de CPUs)
# VLADO_EXTRACAO_TEMPO_MAXIMO=14400 # segundos de relógio por arquivo (4 horas)
# VLADO_EXTRACAO_TETO_PAGINAS=3000  # páginas por PDF
# VLADO_EXTRACAO_TETO_MEGAPIXELS=150  # megapixels por página a 300 dpi e por imagem
# VLADO_EXTRACAO_TETO_MEMORIA_MB=2048 # memória de cada processo de extração
# VLADO_EXTRACAO_TETO_CPU_S=7200    # segundos de CPU por arquivo
# VLADO_EXTRACAO_NUCLEOS=3          # núcleos da extração (padrão: CPUs menos um, no mínimo um)
