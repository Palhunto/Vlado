# Ambiente: demonstracao — copie para deploy/ambientes/demonstracao.env (fora do git) e preencha.
# Apresentação em sala: dados e contas sintéticos. O APK 'sala' aponta para este domínio.
VLADO_AMBIENTE=demonstracao
# PREENCHER: domínio público deste ambiente (DNS apontando para o servidor).
VLADO_DOMINIO=demo.vlado.example.org
# Tag da imagem; mantenha a anterior para reverter.
VLADO_VERSAO=2.0.0
# Portas publicadas pelo Caddy (padrão 80/443).
# VLADO_PORTA_HTTP=80
# VLADO_PORTA_HTTPS=443
# VLADO_CADDYFILE=deploy/Caddyfile
# Opcional: chave da API no ambiente (tem prioridade sobre a colada na Mesa). Nunca commitar.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
