# Homologação local: HTTPS com a CA interna do Caddy (o navegador e o emulador precisam
# confiar no certificado raiz em caddy_data/caddy/pki/authorities/local/root.crt).
# Nunca use no ambiente editorial nem na demonstração pública.
{
	# Contêiner somente leitura e sem privilégios: o Caddy não instala a CA no repositório de
	# certificados do contêiner (falharia com "failed to execute tee"). Confie nela no navegador.
	skip_install_trust

	# Log padrão do Caddy (stdout/stderr do contêiner, o que `docker logs` mostra): com a Mesa fora do ar o
	# Caddy registra aqui o erro 502 com a URI inteira (token de /ativar, query) e todos os cabeçalhos
	# (Cookie, X-Session-Token). Mesmo filtro do registro de acesso, sem o campo "rota" (que é do `log_append`
	# do site): nada de URI, cabeçalhos de requisição nem de resposta. Fica horário, nível, IP e o erro.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
}

{$VLADO_DOMINIO} {
	tls internal
	encode gzip
	request_body {
		max_size 80MB
	}
	# Cabeçalhos (SEG-06). `-Server` tira o "Server" da resposta: o do Caddy e o do upstream (que traria a versão do
	# Python). Não repassamos versão nenhuma.
	# HSTS: só no Caddyfile público (aqui a CA é a local e o navegador não deve fixar um nome de teste); a Mesa em modo
	# piloto manda o próprio HSTS de qualquer modo.
	header {
		-Server
	}
	# Registro de acesso: mesmo bloco de deploy/Caddyfile (um teste confere que são idênticos). Sem URI, sem
	# cabeçalhos, sem corpo; token mascarado em "rota". Ver os comentários em deploy/Caddyfile.
	# O log padrão do contêiner (opções globais, acima) leva o mesmo filtro, igual ao de deploy/Caddyfile.
	log_append rota {http.request.uri.path}
	log {
		output file /var/log/caddy/acesso.log {
			roll_size 20MiB
			roll_keep 20
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
				rota regexp "(?P<p>/(?:ativar|convite)/)[^/?#]+|(?P<q>/)[A-Za-z0-9_-]{24,}" "${p}${q}***"
			}
		}
	}
	# Conexão do Caddy para a Mesa: a Mesa fecha a conexão mantida ociosa aos 10 s (CONF-03). Se o Caddy a reutilizasse
	# no instante em que ela fecha, o pedido sairia como 502. keepalive de 5 s: o Caddy descarta a conexão ociosa antes
	# da Mesa (e `keepalive off` desligaria a reutilização por completo, se um dia 5 s não bastar).
	reverse_proxy vlado:8765 {
		transport http {
			keepalive 5s
		}
	}
	# Erros gerados pelo próprio Caddy (502 com a Mesa fora do ar, por exemplo) não passam pelo `header` acima: o Server
	# e o HSTS são tratados aqui também, e o corpo é só o status.
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}"
	}
}
