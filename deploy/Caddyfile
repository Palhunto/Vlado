# HTTPS reverse proxy for the VLADO pilot. Caddy obtains and renews the certificate
# for {$VLADO_DOMINIO} automatically (ports 80 and 443 must reach this host).
{
	# Log padrão do Caddy (stdout/stderr do contêiner, o que `docker logs` mostra): com a Mesa fora do ar o
	# Caddy registra aqui o erro 502 com a URI inteira (token de /ativar, query) e todos os cabeçalhos
	# (Cookie, X-Session-Token). Mesmo filtro do registro de acesso, sem o campo "rota" (que é do `log_append`
	# do site): nada de URI, cabeçalhos de requisição nem de resposta. Fica horário, nível, IP e o erro.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
}

{$VLADO_DOMINIO} {
	encode gzip
	request_body {
		max_size 80MB
	}
	# Cabeçalhos (SEG-06). `-Server` tira o "Server" da resposta: o do Caddy e o do upstream (que traria a versão do
	# Python). Não repassamos versão nenhuma.
	# HSTS por um ano, com includeSubDomains (a Mesa manda o mesmo valor; o Caddy também, para as respostas dele, como o 502).
	# SEM preload, de propósito: ele entra em listas dos navegadores que levam meses para sair; ver deploy/MONITORAMENTO.md.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	# Registro de acesso (uma linha JSON por requisição) em /var/log/caddy/acesso.log, volume caddy_logs.
	# Conteúdo mínimo e sem segredo: o Caddy nunca registra o corpo da requisição; aqui também saem a URI
	# inteira (a query pode levar nome de caso ou de documento), TODOS os cabeçalhos da requisição (Cookie,
	# Authorization, X-Forwarded-*, User-Agent) e TODOS os da resposta (Set-Cookie). Fica o caminho no campo
	# "rota", com o token de /ativar/<token> e /convite/<token> mascarado, e qualquer segmento de 24 ou mais
	# caracteres [A-Za-z0-9_-] também (token, identificador longo, hash). Fica o IP de origem, para investigar
	# incidente. Rotação: 20 MiB por arquivo, 20 arquivos, no máximo 30 dias. Guia: deploy/INCIDENTE.md.
	# O log padrão do contêiner (opções globais, acima) leva o mesmo filtro: também sem URI e sem cabeçalhos.
	log_append rota {http.request.uri.path}
	log {
		output file /var/log/caddy/acesso.log {
			roll_size 20MiB
			roll_keep 20
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
				rota regexp "(?P<p>/(?:ativar|convite)/)[^/?#]+|(?P<q>/)[A-Za-z0-9_-]{24,}" "${p}${q}***"
			}
		}
	}
	# The original Host header is forwarded; the app checks it against https://{$VLADO_DOMINIO}.
	# Conexão do Caddy para a Mesa: a Mesa fecha a conexão mantida ociosa aos 10 s (CONF-03). Se o Caddy a reutilizasse
	# no instante em que ela fecha, o pedido sairia como 502. keepalive de 5 s: o Caddy descarta a conexão ociosa antes
	# da Mesa (e `keepalive off` desligaria a reutilização por completo, se um dia 5 s não bastar).
	reverse_proxy vlado:8765 {
		transport http {
			keepalive 5s
		}
	}
	# Erros gerados pelo próprio Caddy (502 com a Mesa fora do ar, por exemplo) não passam pelo `header` acima: o Server
	# e o HSTS são tratados aqui também, e o corpo é só o status.
	handle_errors {
		header -Server
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		respond "{err.status_code} {err.status_text}"
	}
}
