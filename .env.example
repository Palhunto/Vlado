# Copy to .env (never commit .env). Used by docker-compose.yml.
# Public domain of the pilot; DNS must point to this server.
VLADO_DOMINIO=vlado.example.org
# Image tag for rollbacks: build with a tag, keep the previous one.
VLADO_VERSAO=2.0.0
# homologacao | editorial | demonstracao (ver deploy/ambientes/*.env.example)
VLADO_AMBIENTE=homologacao
# Optional: set the API key here instead of pasting it in the Mesa (environment takes precedence).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
